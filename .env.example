# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Server Port (default: 3000)
PORT="3000"

# Admin credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="IeltsCamp2026!"

# Optional: Supabase PostgreSQL configuration for production
# If provided, Netlify Functions and Express server can sync applications directly to Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
